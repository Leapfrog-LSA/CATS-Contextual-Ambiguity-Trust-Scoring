CATS_API_KEY=change-me-strong-random-key
CATS_API_KEY_PREV=
# Optional multi-tenant keys: CSV of "key:tenant" pairs. Unlisted keys
# (CATS_API_KEY/_PREV) resolve to the "default" tenant.
# CATS_API_KEYS=keyA:tenant-a,keyB:tenant-b

DATABASE_URL=postgresql+asyncpg://cats:cats@localhost:5432/cats
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_MAX=30
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_VALIDATOR_TTL_SECONDS=120

AUDIT_ENCRYPTION_KEY=change-me-32-bytes-base64-encoded=
AUDIT_RETENTION_DAYS=90

SPACY_MODEL=it_core_news_lg
NLP_GAMING_MIN_TOKENS=10

# Sentiment backend for volatility: "textblob" (default) or "bert".
# "bert" needs requirements-bert.txt; falls back to textblob if unavailable.
SENTIMENT_BACKEND=textblob
SENTIMENT_MODEL=neuraly/bert-base-italian-cased-sentiment

# Coherence backend: "ner" (default) or "sbert" (needs requirements-sbert.txt;
# falls back to ner if the sentence-transformers model is unavailable).
COHERENCE_BACKEND=ner
COHERENCE_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional: path to a calibrated weights file produced by `make calibrate`
# (see docs/calibration.md). Falls back to static estimates when unset.
# NOTE: the shipped data/calibrated_weights.json was calibrated with the SBERT
# coherence backend — pair it with COHERENCE_BACKEND=sbert, or expect the
# coherence contribution to be forfeited (docs/signal_diagnosis_2026-07.md).
CATS_WEIGHTS_FILE=

# Minimum message count for an evaluation to count as sufficiently evidenced
# (risk R5): below it the response reports evidence.sufficient=false and
# requires_review=true. Flag-only — scores and bands never change.
CATS_MIN_EVIDENCE_MESSAGES=3

# Trust X-Forwarded-For for client-IP extraction (rate limiting, audit).
# Keep true behind the bundled nginx; set false if the app is exposed
# directly, otherwise clients can spoof their IP.
TRUST_PROXY_HEADERS=true

ENVIRONMENT=production
LOG_LEVEL=INFO
# Comma-separated allowed origins. Never use "*": CORS is configured with
# credentials allowed, and browsers reject the combination anyway.
CORS_ORIGINS=
